# 华为账号凭证（容器内自动登录，首次或触发二次验证时执行 `docker exec -it hwcloudpd hwcloudpd --auth-only` 输入验证码）
HUAWEI_USERNAME=
HUAWEI_PASSWORD=
# 不想把明文密码写在这里时，可改为挂载一个只含密码的文件（如 Docker secret），二选一
HUAWEI_PASSWORD_FILE=
HWCLOUD_LOGIN_TIMEOUT=60

# 容器运行身份（填 NAS 上 `id -u` / `id -g` 的结果，避免照片文件属主为 root；留空为 root）
PUID=
PGID=

# 时区与调度
TZ=Asia/Shanghai
CRON_SCHEDULE=0 */2 * * *
HWCLOUD_RUN_ON_STARTUP=true

# 归档目录格式（默认按拍摄日期归档，也支持 {album}/{:%Y/%m} 或 none；格式写错会在启动时报错）
HWCLOUD_FOLDER_STRUCTURE={:%Y/%m/%d}

# 下载规格与去重策略
HWCLOUD_SIZE=original
HWCLOUD_FILE_MATCH_POLICY=name-size-dedup-with-suffix
HWCLOUD_LIVE_PHOTO_POLICY=none

# 增量早停、全量兜底与并发
HWCLOUD_UNTIL_FOUND=50
HWCLOUD_FULL_SCAN_INTERVAL_HOURS=168
HWCLOUD_KEEPALIVE_INTERVAL=60
HWCLOUD_DOWNLOAD_CONCURRENCY=2
HWCLOUD_PAGE_SIZE=100
HWCLOUD_REQUEST_DELAY_MS=120
# 单次同步超过该小时数时健康检查报 unhealthy
HWCLOUD_MAX_SYNC_HOURS=24

# 相册与媒体筛选（逗号分隔，留空默认同步除“最近删除”外的全部相册）
HWCLOUD_ALBUMS=
HWCLOUD_EXCLUDE_ALBUMS=
HWCLOUD_SKIP_VIDEOS=false
HWCLOUD_SKIP_PHOTOS=false
HWCLOUD_SKIP_LIVE_PHOTOS=false
HWCLOUD_SKIP_BURSTS=false
HWCLOUD_ONLY_FAVORITES=false
HWCLOUD_CREATED_AFTER=
HWCLOUD_CREATED_BEFORE=
HWCLOUD_MIN_SIZE=
HWCLOUD_MAX_SIZE=
HWCLOUD_RECENT=

# 元数据
HWCLOUD_SET_EXIF_DATETIME=false
HWCLOUD_XMP_SIDECAR=false

# 同步 / 移动模式（涉及删除，建议先配合 HWCLOUD_DRY_RUN=true 演习一次）
HWCLOUD_DRY_RUN=false
HWCLOUD_AUTO_DELETE=false
HWCLOUD_DELETE_AFTER_DOWNLOAD=false
HWCLOUD_KEEP_CLOUD_RECENT_DAYS=

# 告警（企业微信 / 飞书 / 钉钉 / Bark / Telegram / 通用 JSON Webhook）
HWCLOUD_WEBHOOK_URL=
# auto 按域名自动识别；自建 Bark / 反代时可显式指定 wecom|dingtalk|feishu|telegram|bark|generic
HWCLOUD_WEBHOOK_TYPE=auto
HWCLOUD_TELEGRAM_CHAT_ID=
HWCLOUD_NOTIFICATION_SCRIPT=
HWCLOUD_LOG_LEVEL=INFO
