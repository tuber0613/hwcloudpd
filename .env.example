# 华为账号凭证（容器内自动登录，首次或触发二次验证时配合 `docker exec -it hwcloudpd hwcloudpd --auth-only` 在 bash 输入验证码）
HUAWEI_USERNAME=
HUAWEI_PASSWORD=
HWCLOUD_LOGIN_TIMEOUT=60

# 时区与调度
TZ=Asia/Shanghai
CRON_SCHEDULE=0 */2 * * *

# 归档目录格式（默认按拍摄日期归档，也支持 {album}/{:%Y/%m} 或 none）
HWCLOUD_FOLDER_STRUCTURE={:%Y/%m/%d}

# 下载规格与去重策略
HWCLOUD_SIZE=original
HWCLOUD_FILE_MATCH_POLICY=name-size-dedup-with-suffix
HWCLOUD_LIVE_PHOTO_POLICY=none

# 增量早停与保活并发
HWCLOUD_UNTIL_FOUND=50
HWCLOUD_KEEPALIVE_INTERVAL=60
HWCLOUD_DOWNLOAD_CONCURRENCY=2
HWCLOUD_FULL_SCAN_INTERVAL_HOURS=168

# 相册与媒体筛选（逗号分隔，留空默认同步除“最近删除”外的全部相册）
HWCLOUD_ALBUMS=
HWCLOUD_EXCLUDE_ALBUMS=
HWCLOUD_SKIP_VIDEOS=false
HWCLOUD_SKIP_PHOTOS=false
HWCLOUD_SKIP_LIVE_PHOTOS=false
HWCLOUD_SKIP_BURSTS=false
HWCLOUD_ONLY_FAVORITES=false
HWCLOUD_CREATED_AFTER=
HWCLOUD_CREATED_BEFORE=
HWCLOUD_MIN_SIZE=
HWCLOUD_MAX_SIZE=

# 元数据与同步模式
HWCLOUD_SET_EXIF_DATETIME=false
HWCLOUD_XMP_SIDECAR=false
HWCLOUD_AUTO_DELETE=false
HWCLOUD_KEEP_CLOUD_RECENT_DAYS=

# 登录态失效 / 同步异常告警（支持企业微信 / 飞书 / 钉钉 / Bark / Telegram / 通用 JSON Webhook）
HWCLOUD_WEBHOOK_URL=
HWCLOUD_TELEGRAM_CHAT_ID=
HWCLOUD_LOG_LEVEL=INFO
